{%- comment -%}
  Divisor entre seções (estilo shapedivider.app).

  Adicione esta seção ENTRE duas seções. Ela não ocupa espaço: o desenho é
  sobreposto à borda da seção vizinha.
  - Posição "Embaixo": o formato sobe a partir do fim da seção de CIMA, pintado
    com a cor da seção de BAIXO (a seção de baixo "invade" a de cima).
  - Posição "Em cima": o formato desce a partir do início da seção de BAIXO,
    pintado com a cor da seção de CIMA.
  Cor automática: lida do fundo real da seção vizinha (funciona com cores
  diferentes por seção). Se a vizinha for uma imagem, use a outra posição.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  case s.shape
    when 'triangle'
      assign path = 'M1200 0L0 0 598.97 114.72 1200 0z'
    when 'tilt'
      assign path = 'M1200 120L0 16.48 0 0 1200 0 1200 120z'
    when 'curve'
      assign path = 'M0,0V7.23C0,65.52,268.63,112.77,600,112.77S1200,65.52,1200,7.23V0Z'
    when 'waves'
      assign path = 'M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z'
    when 'arrow'
      assign path = 'M649.97 0L550.03 0 599.91 54.12 649.97 0z'
  endcase
  if s.invert
    assign path = 'M0 0H1200V120H0Z ' | append: path
  endif
  assign fill = 'currentColor'
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 3;
    height: 0;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .shotz-divider {
    --divider-height: {{ s.height_mobile }}px;
    {%- if s.color_mode == 'custom' %}
      color: {{ s.color }};
    {%- endif %}
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .shotz-divider {
      --divider-height: {{ s.height }}px;
    }
  }

  /* Mesma estrutura do shapedivider.app, para o resultado bater com a prévia */
  .shotz-divider {
    position: absolute;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    color: var(--color-background, #f0efeb);
  }

  .shotz-divider--bottom {
    bottom: 0;
    transform: rotate(180deg);
  }

  .shotz-divider--top {
    top: 0;
  }

  .shotz-divider svg {
    position: relative;
    display: block;
    max-width: none;
    width: calc(var(--divider-width, 100%) + 1.3px);
    height: var(--divider-height, 60px);
  }

  .shotz-divider--flip svg {
    transform: rotateY(180deg);
  }

  .shotz-divider__hint {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translate(-50%, -50%);
    z-index: 2;
    max-width: calc(100% - 32px);
    padding: 6px 12px;
    font: 600 12px/1.3 var(--font-body--family, sans-serif);
    color: #fff;
    background: #d9480f;
    border-radius: 999px;
    white-space: normal;
    text-align: center;
    pointer-events: none;
  }
  .shotz-divider__hint[hidden] { display: none; }
{% endstyle %}

{%- liquid
  if s.position == 'top'
    assign side_style = 'top: 0; bottom: auto; transform: none;'
  else
    assign side_style = 'bottom: 0; top: auto; transform: rotate(180deg);'
  endif
  assign svg_transform = 'none'
  if s.flip
    assign svg_transform = 'rotateY(180deg)'
  endif
-%}
{%- comment -%}
  Estilos críticos inline (vencem regras globais do tema, como svg { max-width: 100% }).
{%- endcomment -%}
<div
  class="shotz-divider shotz-divider--{{ s.position }}{% if s.flip %} shotz-divider--flip{% endif %}"
  data-position="{{ s.position }}"
  {% if s.color_mode == 'auto' %}data-auto-color{% endif %}
  style="--divider-width: {{ s.width }}%; position: absolute; left: 0; right: 0; width: 100%; overflow: hidden; line-height: 0; pointer-events: none; {{ side_style }}{% if s.color_mode == 'custom' %} color: {{ s.color }};{% endif %}"
  aria-hidden="true"
>
  <svg
    viewBox="0 0 1200 120"
    preserveAspectRatio="none"
    focusable="false"
    width="100%"
    height="{{ s.height }}"
    style="position: relative; display: block; max-width: none; min-height: 1px; width: calc({{ s.width }}% + 1.3px); height: var(--divider-height, {{ s.height }}px); transform: {{ svg_transform }};"
  >
    <path d="{{ path }}" fill="{{ fill }}"{% if s.invert %} fill-rule="evenodd"{% endif %}></path>
  </svg>
</div>

{%- if request.design_mode -%}
  <p class="shotz-divider__hint" data-divider-hint hidden></p>
{%- endif -%}

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var divider = root.querySelector('[data-auto-color]');
    if (!divider) return;

    var hint = root.querySelector('[data-divider-hint]');
    var preferred = divider.dataset.position;

    function isDivider(el) {
      return el && el.querySelector && el.querySelector(':scope > .shotz-divider');
    }

    function sibling(dir) {
      var el = root;
      do {
        el = dir < 0 ? el.previousElementSibling : el.nextElementSibling;
      } while (el && (isDivider(el) || !el.classList.contains('shopify-section') || el.offsetHeight === 0));
      return el;
    }

    function solid(c) {
      var m = c && c.match(/rgba?\(([^)]+)\)/);
      if (!m) return false;
      var p = m[1].split(',');
      return p.length < 4 || parseFloat(p[3]) > 0.95;
    }

    /* Cor de fundo sólida da seção e se ela é "de imagem" (foto/vídeo ocupando a largura) */
    function inspect(section) {
      var info = { color: null, image: false };
      if (!section) return info;
      var width = section.getBoundingClientRect().width;
      var queue = [section];
      var seen = 0;
      while (queue.length && seen < 200) {
        var el = queue.shift();
        seen++;
        var r = el.getBoundingClientRect();
        var wide = r.width >= width * 0.9;
        var cs = getComputedStyle(el);
        if (wide && r.height >= 120) {
          if (/^(IMG|VIDEO|PICTURE)$/.test(el.tagName) || (cs.backgroundImage && cs.backgroundImage.indexOf('url(') !== -1)) {
            info.image = true;
          }
        }
        if (!info.color && wide && solid(cs.backgroundColor)) info.color = cs.backgroundColor;
        for (var i = 0; i < el.children.length; i++) queue.push(el.children[i]);
      }
      if (!info.color) info.color = getComputedStyle(document.body).backgroundColor;
      return info;
    }

    function apply() {
      var above = inspect(sibling(-1));
      var below = inspect(sibling(1));

      // Escolhe o lado: o formato é desenhado SOBRE a seção de imagem, na cor da seção lisa
      var pos = preferred;
      if (pos === 'bottom' && below.image && !above.image) pos = 'top';
      if (pos === 'top' && above.image && !below.image) pos = 'bottom';

      var color = pos === 'bottom' ? below.color : above.color;
      var under = pos === 'bottom' ? above : below;

      divider.dataset.position = pos;
      divider.classList.toggle('shotz-divider--bottom', pos === 'bottom');
      divider.classList.toggle('shotz-divider--top', pos === 'top');
      divider.style.top = pos === 'top' ? '0' : 'auto';
      divider.style.bottom = pos === 'top' ? 'auto' : '0';
      divider.style.transform = pos === 'top' ? 'none' : 'rotate(180deg)';
      divider.style.color = color;

      if (hint) {
        var invisible = !under.image && under.color === color;
        hint.hidden = !invisible;
        hint.textContent = invisible
          ? 'Divisor invisível: as duas seções têm a mesma cor. Mude a cor de uma delas ou mova o divisor.'
          : '';
      }
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply);
    else apply();
    window.addEventListener('load', apply);
    document.addEventListener('shopify:section:load', apply);
  })();
</script>



{% schema %}
{
  "name": "Divisor",
  "tag": "div",
  "class": "shotz-divider-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Coloque esta seção entre duas seções. Ela não ocupa espaço: o formato fica sobre a borda da seção vizinha."
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Formato",
      "options": [
        { "value": "triangle", "label": "Triângulo" },
        { "value": "tilt", "label": "Inclinado" },
        { "value": "curve", "label": "Curva" },
        { "value": "waves", "label": "Ondas" },
        { "value": "arrow", "label": "Seta" }
      ],
      "default": "triangle"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Posição",
      "info": "Embaixo: o formato sobe sobre o fim da seção de cima, na cor da seção de baixo. Em cima: desce sobre o início da seção de baixo, na cor da seção de cima.",
      "options": [
        { "value": "bottom", "label": "Embaixo" },
        { "value": "top", "label": "Em cima" }
      ],
      "default": "bottom"
    },
    { "type": "checkbox", "id": "flip", "label": "Espelhar (flip)", "default": false },
    { "type": "checkbox", "id": "invert", "label": "Inverter", "default": false },
    {
      "type": "range",
      "id": "height",
      "label": "Altura (desktop)",
      "min": 10,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Altura (mobile)",
      "min": 10,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "width",
      "label": "Largura",
      "min": 100,
      "max": 300,
      "step": 2,
      "unit": "%",
      "default": 136
    },
    {
      "type": "select",
      "id": "color_mode",
      "label": "Cor",
      "options": [
        { "value": "auto", "label": "Automática (cor da seção vizinha)" },
        { "value": "custom", "label": "Personalizada" }
      ],
      "default": "auto"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Cor personalizada",
      "default": "#F0EFEB",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    }
  ],
  "presets": [{ "name": "Divisor" }]
}
{% endschema %}
