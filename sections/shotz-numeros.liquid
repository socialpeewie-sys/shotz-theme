{% assign nid = section.id | replace: '_', '' | downcase %}

{% style %}
  .shotz-numeros-{{ nid }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    width: 100%;
  }

  .shotz-numeros-inner-{{ nid }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .shotz-numeros-heading-{{ nid }} {
    margin: 0;
    font-family: var(--font-heading--family), 'Plus Jakarta Sans', sans-serif;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: {{ section.settings.heading_color }};
  }

  .shotz-numeros-subtitle-{{ nid }} {
    margin: 16px 0 0;
    max-width: 52ch;
    font-family: var(--font-body--family), 'Plus Jakarta Sans', sans-serif;
    font-size: {{ section.settings.subtitle_size }}px;
    line-height: 1.5;
    color: {{ section.settings.subtitle_color }};
  }

  .shotz-numeros-grid-{{ nid }} {
    margin-top: {{ section.settings.grid_gap_top }}px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px 64px;
  }

  .shotz-numeros-item-{{ nid }} {
    display: flex;
    flex-direction: column;
  }

  .shotz-numeros-number-{{ nid }} {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-heading--family), 'Plus Jakarta Sans', sans-serif;
    font-size: {{ section.settings.number_size }}px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: {{ section.settings.number_color }};
  }

  .shotz-numeros-unit-{{ nid }} {
    margin-left: 2px;
    font-size: 0.42em;
    font-weight: 800;
    letter-spacing: 0;
    color: {{ section.settings.accent_color }};
  }

  .shotz-numeros-label-{{ nid }} {
    margin: 10px 0 0;
    font-family: var(--font-heading--family), 'Plus Jakarta Sans', sans-serif;
    font-size: {{ section.settings.label_size }}px;
    font-weight: 800;
    line-height: 1.2;
    color: {{ section.settings.label_color }};
  }

  @media screen and (max-width: 749px) {
    .shotz-numeros-heading-{{ nid }} {
      font-size: {{ section.settings.heading_size | times: 0.62 | round }}px;
    }

    .shotz-numeros-grid-{{ nid }} {
      gap: 32px;
    }

    .shotz-numeros-item-{{ nid }} {
      flex: 0 0 calc(50% - 16px);
    }

    .shotz-numeros-number-{{ nid }} {
      font-size: {{ section.settings.number_size | times: 0.66 | round }}px;
    }
  }
{% endstyle %}

<div class="shotz-numeros-{{ nid }}" {{ section.shopify_attributes }}>
  <div class="shotz-numeros-inner-{{ nid }}">
    {% if section.settings.heading != blank %}
      <h2 class="shotz-numeros-heading-{{ nid }}">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <p class="shotz-numeros-subtitle-{{ nid }}">{{ section.settings.subtitle }}</p>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="shotz-numeros-grid-{{ nid }}">
        {% for block in section.blocks %}
          {% if block.type == 'numero' %}
            <div class="shotz-numeros-item-{{ nid }}" {{ block.shopify_attributes }}>
              {% if block.settings.number != blank %}
                <span class="shotz-numeros-number-{{ nid }}">
                  {{- block.settings.number -}}
                  {%- if block.settings.unit != blank -%}
                    <span class="shotz-numeros-unit-{{ nid }}">{{ block.settings.unit }}</span>
                  {%- endif -%}
                </span>
              {% endif %}
              {% if block.settings.label != blank %}
                <p class="shotz-numeros-label-{{ nid }}">{{ block.settings.label }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Números em destaque",
  "tag": "section",
  "class": "section-shotz-numeros",
  "settings": [
    {
      "type": "header",
      "content": "Conteúdo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Pequenas escolhas, grandes resultados"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Uma rotina que você mantém vale mais que a perfeita que você abandona. Consistência é a chave."
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo",
      "default": "#FAF7EF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Cor do título",
      "default": "#1A2740"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Cor do subtítulo",
      "default": "#5A6273"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Cor dos números",
      "default": "#1A2740"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor de destaque (unidade)",
      "default": "#0094F6"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Cor do rótulo",
      "default": "#1A2740"
    },
    {
      "type": "header",
      "content": "Tipografia"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamanho do título",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Tamanho do subtítulo",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "Tamanho dos números",
      "min": 40,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Tamanho do rótulo",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "grid_gap_top",
      "label": "Espaço acima dos números",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largura máxima",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "numero",
      "name": "Número",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Número",
          "default": "21"
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Unidade (destaque)",
          "info": "Sufixo menor e colorido, ex.: g, ml, oz, s."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Rótulo",
          "default": "Rótulo do número"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Números em destaque",
      "blocks": [
        { "type": "numero", "settings": { "number": "21", "unit": "g", "label": "Proteína de qualidade" } },
        { "type": "numero", "settings": { "number": "100", "unit": "ml", "label": "Pronto pra tomar" } },
        { "type": "numero", "settings": { "number": "0", "unit": "g", "label": "Açúcar" } },
        { "type": "numero", "settings": { "number": "0", "unit": "g", "label": "Lactose" } },
        { "type": "numero", "settings": { "number": "5", "unit": "s", "label": "Do bolso ao gole" } }
      ]
    }
  ]
}
{% endschema %}
