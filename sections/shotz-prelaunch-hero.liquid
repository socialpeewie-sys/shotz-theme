{% doc %}
  Hero section for the Shotz pre-launch landing page.
{% enddoc %}

{{ 'shotz-prelaunch.css' | asset_url | stylesheet_tag }}

<section class="spl-card-full spl-hero">
  <div class="spl-hero__bg">
    {% if section.settings.hero_video %}
      {{
        section.settings.hero_video
        | video_tag:
          image_size: '1500x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          class: 'spl-hero__media'
      }}
    {% elsif section.settings.hero_image %}
      {{
        section.settings.hero_image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '(min-width: 1440px) 1440px, 100vw',
          widths: '750, 1100, 1500, 2000',
          class: 'spl-hero__media'
      }}
    {% else %}
      <div class="spl-hero__placeholder" aria-hidden="true">
        <span>foto ou vídeo: rotina / lifestyle</span>
      </div>
    {% endif %}
    <div class="spl-hero__overlay"></div>
  </div>

  <div class="spl-hero__content">
    {% if section.settings.logo_image %}
      <div class="spl-hero__logo">
        {{ section.settings.logo_image | image_url: width: 400 | image_tag: loading: 'eager' }}
      </div>
    {% elsif section.settings.logo_text != blank %}
      <div class="spl-wordmark">{{ section.settings.logo_text }}</div>
    {% endif %}

    {% if section.settings.headline != blank %}
      <h1 class="spl-hero__headline">{{ section.settings.headline }}</h1>
    {% endif %}

    {% if section.settings.subheadline != blank %}
      <p class="spl-hero__subheadline">{{ section.settings.subheadline }}</p>
    {% endif %}

    {% if section.settings.tagline_1 != blank
      or section.settings.tagline_2 != blank
      or section.settings.tagline_3 != blank
    %}
      <p class="spl-tagline">
        {% if section.settings.tagline_1 != blank %}
          <span class="spl-tagline__white">{{ section.settings.tagline_1 }}</span>
        {% endif %}
        {% if section.settings.tagline_2 != blank %}
          <span class="spl-tagline__accent">{{ section.settings.tagline_2 }}</span>
        {% endif %}
        {% if section.settings.tagline_3 != blank %}
          <span class="spl-tagline__white">{{ section.settings.tagline_3 }}</span>
        {% endif %}
      </p>
    {% endif %}

    {% if section.settings.pill_text != blank %}
      <span class="spl-glass-pill">{{ section.settings.pill_text }}</span>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <div>
        {% render 'shotz-prelaunch-button',
          label: section.settings.button_label,
          link: section.settings.button_link
        %}
      </div>
    {% endif %}

    {% if section.settings.caption != blank %}
      <p class="spl-caption">{{ section.settings.caption }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Prelaunch — Hero",
  "class": "spl-scope spl-section",
  "settings": [
    {
      "type": "header",
      "content": "Mídia"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo (PNG)",
      "info": "Se definido, substitui o texto do logo."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo — texto",
      "default": "SHOTZ"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Vídeo de fundo",
      "info": "Se definido, tem prioridade sobre a foto de fundo abaixo."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Foto de fundo",
      "info": "Usada quando nenhum vídeo é definido."
    },
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "html",
      "id": "headline",
      "label": "Título (H1)",
      "info": "Use <br> para quebra de linha.",
      "default": "Sua rotina já é complexa.<br>Consumir proteína não precisa ser."
    },
    {
      "type": "inline_richtext",
      "id": "subheadline",
      "label": "Subtítulo",
      "default": "Shotz é um shot proteico com 20g de proteína criado para tornar o consumo de proteína mais simples."
    },
    {
      "type": "text",
      "id": "tagline_1",
      "label": "Tagline — palavra 1",
      "default": "Pronto."
    },
    {
      "type": "text",
      "id": "tagline_2",
      "label": "Tagline — palavra 2 (azul)",
      "default": "Prático."
    },
    {
      "type": "text",
      "id": "tagline_3",
      "label": "Tagline — palavra 3",
      "default": "Proteico."
    },
    {
      "type": "textarea",
      "id": "pill_text",
      "label": "Texto da pílula",
      "default": "Cadastre-se para ter acesso antecipado ao lançamento e garanta 10% OFF na sua primeira compra."
    },
    {
      "type": "header",
      "content": "Botão"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "info": "Deixe vazio para ocultar o botão.",
      "default": "Quero acesso antecipado"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão",
      "info": "Deixe vazio para abrir o formulário de cadastro."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Legenda abaixo do botão",
      "default": "Vagas limitadas"
    }
  ],
  "presets": [
    {
      "name": "Prelaunch — Hero"
    }
  ]
}
{% endschema %}
