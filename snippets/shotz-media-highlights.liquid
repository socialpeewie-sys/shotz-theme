{%- doc -%}
  Cards de destaque (ícone + título + texto) exibidos junto à galeria da PDP.
  No desktop ficam empilhados ao lado da primeira imagem do grid; no mobile
  aparecem lado a lado logo abaixo do carrossel.

  @param {object} block_settings - Configurações do bloco _product-media-gallery
  @param {string} tag - Tag do contêiner ('li' dentro do grid, 'div' no mobile)
  @param {string} [class] - Classes extras do contêiner
{%- enddoc -%}

<{{ tag }}
  class="media-gallery__highlights {{ class }}"
  style="--highlight-bg: {{ block_settings.highlight_background }}; --highlight-icon-bg: {{ block_settings.highlight_icon_background }}; --highlight-icon-color: {{ block_settings.highlight_icon_color }};"
>
  {%- for i in (1..3) -%}
    {%- liquid
      assign icon_key = 'highlight_' | append: i | append: '_icon'
      assign title_key = 'highlight_' | append: i | append: '_title'
      assign text_key = 'highlight_' | append: i | append: '_text'
      assign h_icon = block_settings[icon_key]
      assign h_title = block_settings[title_key]
      assign h_text = block_settings[text_key]
    -%}
    {%- if h_title != blank or h_text != blank -%}
      <div class="media-gallery__highlight">
        {%- if h_icon != blank and h_icon != 'none' -%}
          <span class="media-gallery__highlight-icon">
            {%- render 'shotz-numeros-icon', icon: h_icon -%}
          </span>
        {%- endif -%}
        {%- if h_title != blank -%}
          <p class="media-gallery__highlight-title">{{ h_title }}</p>
        {%- endif -%}
        {%- if h_text != blank -%}
          <p class="media-gallery__highlight-text">{{ h_text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
</{{ tag }}>

{% stylesheet %}
  .media-gallery__highlights {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .media-gallery__highlights--mobile {
    margin-top: 12px;
  }

  .media-gallery__highlight {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    padding: 16px 8px;
    text-align: center;
    background-color: var(--highlight-bg);
    border-radius: min(var(--media-radius, 16px), 24px);
    box-sizing: border-box;
  }

  .media-gallery__highlight-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-bottom: 6px;
    border-radius: 50%;
    background-color: var(--highlight-icon-bg);
    color: var(--highlight-icon-color);
  }

  .media-gallery__highlight-icon svg {
    width: 22px;
    height: 22px;
  }

  .media-gallery__highlight-title {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .media-gallery__highlight-text {
    margin: 0;
    font-size: 12px;
    line-height: 1.35;
    opacity: 0.7;
  }

  /* Mídia em proporção fixa (cover): 1:1 por padrão, 2:1 na imagem wide */
  media-gallery.media-gallery--highlights .product-media-container {
    --gallery-aspect-ratio: 1;
  }

  media-gallery.media-gallery--highlights .product-media-container :is(img, video, iframe, .deferred-media__poster-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (min-width: 750px) {
    /* Grid desktop (referência): 1ª imagem 1:1 (3/4) + cards (1/4),
       linha de 3 quadradas, imagem wide 2:1, linha de 3 quadradas */
    media-gallery.media-gallery--highlights .media-gallery__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    media-gallery.media-gallery--highlights .media-gallery__grid > .product-media-container {
      grid-column: span 4;
    }

    media-gallery.media-gallery--highlights .media-gallery__grid > .product-media-container:first-child {
      grid-column: span 9;
    }

    media-gallery.media-gallery--highlights .media-gallery__grid > .product-media-container:nth-child(6) {
      --gallery-aspect-ratio: 2;
      grid-column: 1 / -1;
    }

    media-gallery.media-gallery--highlights .media-gallery__grid > .media-gallery__highlights {
      grid-column: span 3;
      grid-auto-flow: row;
      grid-template-columns: 1fr;
      grid-auto-rows: 1fr;
      gap: var(--image-gap);
    }

    media-gallery.media-gallery--grid .media-gallery__highlights--mobile {
      display: none;
    }

    .media-gallery__highlights > .media-gallery__highlight {
      justify-content: center;
    }

    .media-gallery__highlight-title {
      font-size: 16px;
    }

    .media-gallery__highlight-text {
      font-size: 13px;
    }
  }
{% endstylesheet %}
