<style>
  .shotz-benefits {
    position: relative;
    background-color: var(--sb-bg-color, #0d0d0d);
    padding: 80px 20px;
    min-height: var(--sb-min-height, auto);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .shotz-benefits__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .shotz-benefits__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--sb-bg-position, center);
    display: block;
  }

  .shotz-benefits__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--sb-overlay-color, #000);
    opacity: var(--sb-overlay-opacity, 0.5);
    pointer-events: none;
  }

  .shotz-benefits__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }

  .shotz-benefits__eyebrow {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    margin-bottom: 12px;
  }

  .shotz-benefits__heading {
    font-size: clamp(26px, 4vw, 50px);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 14px;
    line-height: 1.1;
  }

  .shotz-benefits__sub {
    font-size: 17px;
    color: rgba(255,255,255,0.6);
    margin-bottom: 50px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  .shotz-benefits__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .shotz-benefits__card {
    background: rgba(255,255,255,0.07);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    padding: 28px 24px;
    text-align: left;
  }

  .shotz-benefits__icon {
    width: 48px;
    height: 48px;
    background: rgba(255,255,255,0.1);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    margin-bottom: 20px;
  }

  .shotz-benefits__card-title {
    font-size: 17px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 10px;
  }

  .shotz-benefits__card-text {
    font-size: 14px;
    color: rgba(255,255,255,0.6);
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 768px) {
    .shotz-benefits__cards {
      grid-template-columns: 1fr;
    }
    .shotz-benefits {
      min-height: var(--sb-min-height-mobile, auto);
    }
  }
</style>

{%- liquid
  assign bg_desktop = section.settings.bg_image
  assign bg_mobile = section.settings.bg_image_mobile | default: bg_desktop
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign min_height_mobile = section.settings.min_height | times: 0.7 | round
-%}

<section
  class="shotz-benefits"
  style="
    --sb-bg-color: {{ section.settings.background_color }};
    --sb-bg-position: {{ section.settings.bg_position }};
    --sb-overlay-color: {{ section.settings.overlay_color }};
    --sb-overlay-opacity: {{ overlay_opacity }};
    {%- if section.settings.min_height > 0 %}
      --sb-min-height: {{ section.settings.min_height }}px;
      --sb-min-height-mobile: {{ min_height_mobile }}px;
    {%- endif %}
  "
>

  {%- if bg_desktop != blank or bg_mobile != blank -%}
    <div class="shotz-benefits__bg">
      <picture>
        {%- if section.settings.bg_image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ bg_mobile | image_url: width: 600 }} 600w,
              {{ bg_mobile | image_url: width: 900 }} 900w,
              {{ bg_mobile | image_url: width: 1200 }} 1200w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {%- assign bg_main = bg_desktop | default: bg_mobile -%}
        {{
          bg_main
          | image_url: width: 2400
          | image_tag: loading: 'lazy', alt: '', sizes: '100vw', widths: '750, 1100, 1500, 1920, 2400'
        }}
      </picture>
    </div>
    <div class="shotz-benefits__overlay"></div>
  {%- endif -%}

  <div class="shotz-benefits__content">
    {% if section.settings.eyebrow != blank %}
      <p class="shotz-benefits__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="shotz-benefits__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="shotz-benefits__sub">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="shotz-benefits__cards">
      {% for block in section.blocks %}
        <div class="shotz-benefits__card" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="shotz-benefits__icon">{{ block.settings.icon }}</div>
          {% endif %}
          {% if block.settings.title != blank %}
            <p class="shotz-benefits__card-title">{{ block.settings.title }}</p>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="shotz-benefits__card-text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

</section>

{% schema %}
{
  "name": "Shotz – Benefits",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto eyebrow",
      "default": "A ciência por trás"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "O que faz o Shotz funcionar."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Tudo o que você precisa. Em uma única dose."
    },
    {
      "type": "header",
      "content": "Imagem de fundo"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Imagem de fundo",
      "info": "Cobre a seção inteira, como um banner. Recomendado: 2400 × 1200 px."
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Imagem de fundo (celular)",
      "info": "Opcional. Se vazio, usa a imagem de fundo acima."
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Foco da imagem",
      "options": [
        { "value": "center", "label": "Centro" },
        { "value": "top", "label": "Topo" },
        { "value": "bottom", "label": "Base" },
        { "value": "left", "label": "Esquerda" },
        { "value": "right", "label": "Direita" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Cor da camada sobre a imagem",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidade da camada",
      "info": "Escurece a imagem para o texto ficar legível.",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Altura mínima",
      "info": "0 = altura automática pelo conteúdo. No celular usa 70% deste valor.",
      "min": 0,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo (sem imagem)",
      "default": "#0D0D0D"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card de benefício",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Ícone (emoji)",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título do card"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descrição"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shotz – Benefits",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "icon": "⚡",
            "title": "Proteína instantânea",
            "text": "Alta biodisponibilidade. Sem o processo lento do pó diluído."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "🦴",
            "title": "Colágeno Completo",
            "text": "Tipos I, II e III. Para pele, articulações e recuperação muscular."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "🚫",
            "title": "Zero açúcar",
            "text": "Sem pico de glicose. Sem crash. Energia limpa o dia todo."
          }
        }
      ]
    }
  ]
}
{% endschema %}