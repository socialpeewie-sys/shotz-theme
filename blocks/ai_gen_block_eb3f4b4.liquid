{% doc %}
  @prompt
    Reformulate the shotz-benefits block:
    - Remove the background image entirely (no more image behind the section).
    - Cards are no longer frosted/liquid glass — each card gets its own configurable solid background color.
    - Cards stack vertically, one on top of the other, alternating horizontal alignment: the first card sits more to the right, the second more to the left, and so on.
    - Each card exposes: background color, text alignment, title font size, title, subtitle, and an optional small image (icon) shown inside the card.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .shotz-benefits-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: 80px 20px;
    overflow: hidden;
  }

  .shotz-benefits-container-{{ ai_gen_id }} {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }

  .shotz-benefits-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .shotz-benefits-eyebrow-{{ ai_gen_id }} {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ block.settings.text_color }};
    margin-bottom: 16px;
    opacity: 0.8;
  }

  .shotz-benefits-heading-{{ ai_gen_id }} {
    font-size: 48px;
    font-weight: 800;
    color: {{ block.settings.text_color }};
    margin: 0 0 20px;
    line-height: 1.2;
  }

  .shotz-benefits-subheading-{{ ai_gen_id }} {
    font-size: 18px;
    color: {{ block.settings.text_color }};
    opacity: 0.9;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .shotz-benefits-cards-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .shotz-benefits-card-{{ ai_gen_id }} {
    width: 100%;
    max-width: 560px;
    border-radius: 16px;
    padding: 32px 28px;
  }

  .shotz-benefits-card-{{ ai_gen_id }}:nth-child(odd) {
    margin-left: auto;
    margin-right: 0;
  }

  .shotz-benefits-card-{{ ai_gen_id }}:nth-child(even) {
    margin-left: 0;
    margin-right: auto;
  }

  .shotz-benefits-card-icon-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    object-fit: contain;
    margin-bottom: 16px;
    display: block;
  }

  .shotz-benefits-card-title-{{ ai_gen_id }} {
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 12px;
    line-height: 1.3;
  }

  .shotz-benefits-card-description-{{ ai_gen_id }} {
    color: #ffffff;
    opacity: 0.8;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .shotz-benefits-{{ ai_gen_id }} {
      padding: 60px 16px;
    }

    .shotz-benefits-heading-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .shotz-benefits-subheading-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .shotz-benefits-header-{{ ai_gen_id }} {
      margin-bottom: 40px;
    }

    .shotz-benefits-card-{{ ai_gen_id }} {
      max-width: 100%;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }
  }
{% endstyle %}

<div class="shotz-benefits-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="shotz-benefits-container-{{ ai_gen_id }}">
    <div class="shotz-benefits-header-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <div class="shotz-benefits-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="shotz-benefits-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <p class="shotz-benefits-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="shotz-benefits-cards-{{ ai_gen_id }}">
      {% if block.settings.card_1_icon != blank or block.settings.card_1_title != blank or block.settings.card_1_description != blank %}
        <div
          class="shotz-benefits-card-{{ ai_gen_id }}"
          style="background-color: {{ block.settings.card_1_bg_color }}; text-align: {{ block.settings.card_1_text_align }};"
        >
          {% if block.settings.card_1_icon != blank %}
            <img
              class="shotz-benefits-card-icon-{{ ai_gen_id }}"
              src="{{ block.settings.card_1_icon | image_url: width: 80 }}"
              alt="{{ block.settings.card_1_title | escape }}"
              loading="lazy"
              width="40"
              height="40"
              {% if block.settings.card_1_text_align == 'center' %}
                style="margin-left: auto; margin-right: auto;"
              {% elsif block.settings.card_1_text_align == 'right' %}
                style="margin-left: auto;"
              {% endif %}
            >
          {% endif %}

          {% if block.settings.card_1_title != blank %}
            <h3
              class="shotz-benefits-card-title-{{ ai_gen_id }}"
              style="font-size: {{ block.settings.card_1_title_size }}px;"
            >
              {{ block.settings.card_1_title }}
            </h3>
          {% endif %}

          {% if block.settings.card_1_description != blank %}
            <p
              class="shotz-benefits-card-description-{{ ai_gen_id }}"
              style="font-size: {{ block.settings.card_1_description_size }}px;"
            >
              {{ block.settings.card_1_description }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_2_icon != blank or block.settings.card_2_title != blank or block.settings.card_2_description != blank %}
        <div
          class="shotz-benefits-card-{{ ai_gen_id }}"
          style="background-color: {{ block.settings.card_2_bg_color }}; text-align: {{ block.settings.card_2_text_align }};"
        >
          {% if block.settings.card_2_icon != blank %}
            <img
              class="shotz-benefits-card-icon-{{ ai_gen_id }}"
              src="{{ block.settings.card_2_icon | image_url: width: 80 }}"
              alt="{{ block.settings.card_2_title | escape }}"
              loading="lazy"
              width="40"
              height="40"
              {% if block.settings.card_2_text_align == 'center' %}
                style="margin-left: auto; margin-right: auto;"
              {% elsif block.settings.card_2_text_align == 'right' %}
                style="margin-left: auto;"
              {% endif %}
            >
          {% endif %}

          {% if block.settings.card_2_title != blank %}
            <h3
              class="shotz-benefits-card-title-{{ ai_gen_id }}"
              style="font-size: {{ block.settings.card_2_title_size }}px;"
            >
              {{ block.settings.card_2_title }}
            </h3>
          {% endif %}

          {% if block.settings.card_2_description != blank %}
            <p
              class="shotz-benefits-card-description-{{ ai_gen_id }}"
              style="font-size: {{ block.settings.card_2_description_size }}px;"
            >
              {{ block.settings.card_2_description }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_3_icon != blank or block.settings.card_3_title != blank or block.settings.card_3_description != blank %}
        <div
          class="shotz-benefits-card-{{ ai_gen_id }}"
          style="background-color: {{ block.settings.card_3_bg_color }}; text-align: {{ block.settings.card_3_text_align }};"
        >
          {% if block.settings.card_3_icon != blank %}
            <img
              class="shotz-benefits-card-icon-{{ ai_gen_id }}"
              src="{{ block.settings.card_3_icon | image_url: width: 80 }}"
              alt="{{ block.settings.card_3_title | escape }}"
              loading="lazy"
              width="40"
              height="40"
              {% if block.settings.card_3_text_align == 'center' %}
                style="margin-left: auto; margin-right: auto;"
              {% elsif block.settings.card_3_text_align == 'right' %}
                style="margin-left: auto;"
              {% endif %}
            >
          {% endif %}

          {% if block.settings.card_3_title != blank %}
            <h3
              class="shotz-benefits-card-title-{{ ai_gen_id }}"
              style="font-size: {{ block.settings.card_3_title_size }}px;"
            >
              {{ block.settings.card_3_title }}
            </h3>
          {% endif %}

          {% if block.settings.card_3_description != blank %}
            <p
              class="shotz-benefits-card-description-{{ ai_gen_id }}"
              style="font-size: {{ block.settings.card_3_description_size }}px;"
            >
              {{ block.settings.card_3_description }}
            </p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shotz benefits",
  "tag": null,
  "class": "shotz-benefits-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Block background color",
      "default": "#0d0d0d"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Por que escolher"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Benefícios do SHOTZ"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Proteína de alta qualidade em formato prático para o seu dia a dia"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Header text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Card 1"
    },
    {
      "type": "image_picker",
      "id": "card_1_icon",
      "label": "Icon image (optional)"
    },
    {
      "type": "color",
      "id": "card_1_bg_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "card_1_text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "card_1_title_size",
      "label": "Title font size",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "text",
      "id": "card_1_title",
      "label": "Title",
      "default": "Alta proteína"
    },
    {
      "type": "textarea",
      "id": "card_1_description",
      "label": "Subtitle",
      "default": "25g de proteína por shot para máxima recuperação muscular"
    },
    {
      "type": "range",
      "id": "card_1_description_size",
      "label": "Subtitle font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Card 2"
    },
    {
      "type": "image_picker",
      "id": "card_2_icon",
      "label": "Icon image (optional)"
    },
    {
      "type": "color",
      "id": "card_2_bg_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "card_2_text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "card_2_title_size",
      "label": "Title font size",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "text",
      "id": "card_2_title",
      "label": "Title",
      "default": "Energia rápida"
    },
    {
      "type": "textarea",
      "id": "card_2_description",
      "label": "Subtitle",
      "default": "Absorção imediata para resultados quando você mais precisa"
    },
    {
      "type": "range",
      "id": "card_2_description_size",
      "label": "Subtitle font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Card 3"
    },
    {
      "type": "image_picker",
      "id": "card_3_icon",
      "label": "Icon image (optional)"
    },
    {
      "type": "color",
      "id": "card_3_bg_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "card_3_text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "card_3_title_size",
      "label": "Title font size",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "text",
      "id": "card_3_title",
      "label": "Title",
      "default": "Praticidade total"
    },
    {
      "type": "textarea",
      "id": "card_3_description",
      "label": "Subtitle",
      "default": "Leve para qualquer lugar e consuma em segundos"
    },
    {
      "type": "range",
      "id": "card_3_description_size",
      "label": "Subtitle font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Shotz benefits"
    }
  ]
}
