{% doc %}
  @prompt
    Bloco "Números em destaque" — título + subtítulo + fileira de números
    grandes, cada um com unidade em destaque (cor de acento) e rótulo.
    Editável no Customizador do tema Horizon, sem JS externo.
{% enddoc %}

{% assign nid = block.id | replace: '_', '' | downcase %}

{% style %}
  .shotz-numeros-{{ nid }} {
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    width: 100%;
  }

  .shotz-numeros-inner-{{ nid }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .shotz-numeros-heading-{{ nid }} {
    margin: 0;
    font-family: var(--font-heading--family), 'Plus Jakarta Sans', sans-serif;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: {{ block.settings.heading_color }};
  }

  .shotz-numeros-subtitle-{{ nid }} {
    margin: 16px 0 0;
    max-width: 52ch;
    font-family: var(--font-body--family), 'Plus Jakarta Sans', sans-serif;
    font-size: {{ block.settings.subtitle_size }}px;
    line-height: 1.5;
    color: {{ block.settings.subtitle_color }};
  }

  .shotz-numeros-grid-{{ nid }} {
    margin-top: {{ block.settings.grid_gap_top }}px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px 64px;
  }

  .shotz-numeros-item-{{ nid }} {
    display: flex;
    flex-direction: column;
  }

  .shotz-numeros-number-{{ nid }} {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-heading--family), 'Plus Jakarta Sans', sans-serif;
    font-size: {{ block.settings.number_size }}px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: {{ block.settings.number_color }};
  }

  .shotz-numeros-unit-{{ nid }} {
    margin-left: 2px;
    font-size: 0.42em;
    font-weight: 800;
    letter-spacing: 0;
    color: {{ block.settings.accent_color }};
  }

  .shotz-numeros-label-{{ nid }} {
    margin: 10px 0 0;
    font-family: var(--font-heading--family), 'Plus Jakarta Sans', sans-serif;
    font-size: {{ block.settings.label_size }}px;
    font-weight: 800;
    line-height: 1.2;
    color: {{ block.settings.label_color }};
  }

  @media screen and (max-width: 749px) {
    .shotz-numeros-heading-{{ nid }} {
      font-size: {{ block.settings.heading_size | times: 0.62 | round }}px;
    }

    .shotz-numeros-grid-{{ nid }} {
      gap: 32px;
    }

    .shotz-numeros-item-{{ nid }} {
      flex: 0 0 calc(50% - 16px);
    }

    .shotz-numeros-number-{{ nid }} {
      font-size: {{ block.settings.number_size | times: 0.66 | round }}px;
    }
  }
{% endstyle %}

<div class="shotz-numeros-{{ nid }}" {{ block.shopify_attributes }}>
  <div class="shotz-numeros-inner-{{ nid }}">
    {% if block.settings.heading != blank %}
      <h2 class="shotz-numeros-heading-{{ nid }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.subtitle != blank %}
      <p class="shotz-numeros-subtitle-{{ nid }}">{{ block.settings.subtitle }}</p>
    {% endif %}

    <div class="shotz-numeros-grid-{{ nid }}">
      {% for i in (1..6) %}
        {% assign number_key = 'number_' | append: i %}
        {% assign unit_key = 'unit_' | append: i %}
        {% assign label_key = 'label_' | append: i %}
        {% if block.settings[number_key] != blank or block.settings[label_key] != blank %}
          <div class="shotz-numeros-item-{{ nid }}">
            {% if block.settings[number_key] != blank %}
              <span class="shotz-numeros-number-{{ nid }}">
                {{- block.settings[number_key] -}}
                {%- if block.settings[unit_key] != blank -%}
                  <span class="shotz-numeros-unit-{{ nid }}">{{ block.settings[unit_key] }}</span>
                {%- endif -%}
              </span>
            {% endif %}
            {% if block.settings[label_key] != blank %}
              <p class="shotz-numeros-label-{{ nid }}">{{ block.settings[label_key] }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

