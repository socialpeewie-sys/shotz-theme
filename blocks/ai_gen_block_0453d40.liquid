{% doc %}
  @prompt
    PROMPT PARA CLAUDE CODE - BLOCO SHOPIFY PERSONALIZADO "HERO COM BENEFÍCIOS"
    
    Crie um bloco Liquid customizado para tema Shopify Horizon com as seguintes especificações:
    
    ESTRUTURA VISUAL:
    - Layout: 2 colunas (50/50) responsive
    - Coluna esquerda: imagem do produto (full-height, fundo cor customizável)
    - Coluna direita: conteúdo texto
    
    COLUNA ESQUERDA:
    - Campo: imagem (Shopify image picker)
    - Cor de fundo customizável
    - Border-radius no canto superior direito (arredondado, estilo card)
    - Aspectos: cobrir com padding interno
    
    COLUNA DIREITA:
    - Headline (campo texto): tamanho grande, bold
    - Subtítulo (campo textarea): tamanho médio, cor cinza
    - Lista de benefícios dinâmica:
      ├─ Cada item: checkmark (✓) + texto
      ├─ Máximo 4 itens, cada um em um campo de entrada
      ├─ Checkmark: cor customizável (usar cores existentes do tema)
      └─ Espaçamento: vertical ~12px entre itens
    - CTA Button:
      ├─ Texto customizável
      ├─ Link customizável
      └─ Classe de botão padrão do tema
    
    RESPONSIVIDADE:
    - Desktop: 2 colunas flex
    - Mobile: 1 coluna, imagem no topo, conteúdo abaixo
    
    CAMPOS CUSTOMIZÁVEIS NO EDITOR:
    - Imagem do produto
    - Cor de fundo imagem
    - Headline
    - Subtítulo
    - 4x Campos benefícios (text input)
    - Cor do checkmark
    - Texto do botão
    - Link do botão
    
    TECNOLOGIA:
    - Liquid puro
    - Usar variables.css do tema para cores
    - CSS inline na section ou schema
    - Sem dependência de JS externo
    
    OBJETIVO: Bloco reutilizável para home, editável no editor Shopify, sem alterar código existente., de a opção de posicionar o banner na esquerda ou na direita
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-benefits-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 64px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-hero-benefits-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: {% if block.settings.image_position == 'right' %}row-reverse{% else %}row{% endif %};
    width: 100%;
    gap: 0;
  }

  .ai-hero-benefits-image-column-{{ ai_gen_id }} {
    flex: 1;
    background-color: {{ block.settings.image_background_color }};
    overflow: hidden;
    {% if block.settings.image_position == 'right' %}
      border-top-left-radius: {{ block.settings.image_border_radius }}px;
    {% else %}
      border-top-right-radius: {{ block.settings.image_border_radius }}px;
    {% endif %}
  }

  .ai-hero-benefits-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai-hero-benefits-image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-benefits-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.05);
  }

  .ai-hero-benefits-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-hero-benefits-content-column-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px;
    gap: 24px;
  }

  .ai-hero-benefits-headline-{{ ai_gen_id }} {
    font-size: 48px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
    color: var(--color-foreground-heading);
  }

  .ai-hero-benefits-subtitle-{{ ai_gen_id }} {
    font-size: 18px;
    line-height: 1.6;
    color: #6d6d6d;
    margin: 0;
  }

  .ai-hero-benefits-boxes-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-hero-benefits-box-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ai-hero-benefits-box-subtitle-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    color: {{ block.settings.box_subtitle_color }};
  }

  .ai-hero-benefits-box-text-{{ ai_gen_id }} {
    font-size: 16px;
    line-height: 1.6;
    color: #6d6d6d;
    margin: 0;
  }

  .ai-hero-benefits-cta-{{ ai_gen_id }} {
    margin-top: 8px;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-benefits-{{ ai_gen_id }} {
      padding: 40px 0;
    }

    .ai-hero-benefits-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-hero-benefits-image-column-{{ ai_gen_id }} {
      border-top-right-radius: 0;
      border-top-left-radius: 0;
      height: 320px;
    }

    .ai-hero-benefits-content-column-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-hero-benefits-headline-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .ai-hero-benefits-subtitle-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-hero-benefits-box-subtitle-{{ ai_gen_id }} {
      font-size: 18px;
    }

    .ai-hero-benefits-box-text-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="ai-hero-benefits-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-benefits-container-{{ ai_gen_id }}">
    <div class="ai-hero-benefits-image-column-{{ ai_gen_id }}">
      <div class="ai-hero-benefits-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.product_image %}
          <img
            src="{{ block.settings.product_image | image_url: width: 1000 }}"
            alt="{{ block.settings.product_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.product_image.width }}"
            height="{{ block.settings.product_image.height }}"
            class="ai-hero-benefits-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-hero-benefits-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-hero-benefits-content-column-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h2 class="ai-hero-benefits-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}

      {% if block.settings.subtitle != blank %}
        <p class="ai-hero-benefits-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}

      <div class="ai-hero-benefits-boxes-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% assign box_subtitle_key = 'box_' | append: i | append: '_subtitle' %}
          {% assign box_text_key = 'box_' | append: i | append: '_text' %}
          {% if block.settings[box_subtitle_key] != blank or block.settings[box_text_key] != blank %}
            <div class="ai-hero-benefits-box-{{ ai_gen_id }}">
              {% if block.settings[box_subtitle_key] != blank %}
                <h3 class="ai-hero-benefits-box-subtitle-{{ ai_gen_id }}">{{ block.settings[box_subtitle_key] }}</h3>
              {% endif %}
              {% if block.settings[box_text_key] != blank %}
                <p class="ai-hero-benefits-box-text-{{ ai_gen_id }}">{{ block.settings[box_text_key] }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if block.settings.button_text != blank %}
        <div class="ai-hero-benefits-cta-{{ ai_gen_id }}">
          <a
            href="{{ block.settings.button_link }}"
            class="button button--primary"
            style="background-color: {{ block.settings.button_bg_color }}; border-color: {{ block.settings.button_bg_color }}; color: {{ block.settings.button_text_color }};"
          >
            {{ block.settings.button_text }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero com benefícios",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posição da imagem",
      "options": [
        {
          "value": "left",
          "label": "Esquerda"
        },
        {
          "value": "right",
          "label": "Direita"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo da seção",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Imagem"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Imagem do produto"
    },
    {
      "type": "color",
      "id": "image_background_color",
      "label": "Cor de fundo",
      "default": "#f5f5f5"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Arredondamento do canto",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Conteúdo"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Título principal",
      "default": "Potencialize seus resultados"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Descubra os benefícios que vão transformar sua rotina"
    },
    {
      "type": "header",
      "content": "Caixas de conteúdo"
    },
    {
      "type": "color",
      "id": "box_subtitle_color",
      "label": "Cor do subtítulo das caixas",
      "default": "#0a84ff"
    },
    {
      "type": "text",
      "id": "box_1_subtitle",
      "label": "Caixa 1 · Subtítulo",
      "default": "Sabores frutados"
    },
    {
      "type": "textarea",
      "id": "box_1_text",
      "label": "Caixa 1 · Texto",
      "default": "Nada de gosto artificial nem retrogosto de proteína. É leve, refrescante e gostoso de tomar todo dia."
    },
    {
      "type": "text",
      "id": "box_2_subtitle",
      "label": "Caixa 2 · Subtítulo",
      "default": "Zero do que você não quer"
    },
    {
      "type": "textarea",
      "id": "box_2_text",
      "label": "Caixa 2 · Texto",
      "default": "Sem açúcar, sem lactose, sem excessos. Só o que importa para o seu corpo, sem nada que atrapalhe."
    },
    {
      "type": "text",
      "id": "box_3_subtitle",
      "label": "Caixa 3 · Subtítulo",
      "default": "Sem shake, sem sujeira e sem trabalho"
    },
    {
      "type": "textarea",
      "id": "box_3_text",
      "label": "Caixa 3 · Texto",
      "default": "100ml prontos para tomar. Abre, bebe e segue o dia — sem coqueteleira, sem bagunça, sem preparo."
    },
    {
      "type": "text",
      "id": "box_4_subtitle",
      "label": "Caixa 4 · Subtítulo",
      "default": "Proteína completa de verdade"
    },
    {
      "type": "textarea",
      "id": "box_4_text",
      "label": "Caixa 4 · Texto",
      "default": "21g de proteína de alta qualidade, enriquecida com todos os aminoácidos essenciais para recuperar e construir músculo."
    },
    {
      "type": "header",
      "content": "Botão"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto do botão",
      "default": "Comprar agora"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Cor de fundo do botão",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Cor do texto do botão",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Hero com benefícios"
    }
  ]
}
{% endschema %}
