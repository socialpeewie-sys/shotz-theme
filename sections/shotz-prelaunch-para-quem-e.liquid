{% doc %}
  "Para quem é" section for the Shotz pre-launch landing page.
{% enddoc %}

{{ 'shotz-prelaunch.css' | asset_url | stylesheet_tag }}

<section class="spl-card-split spl-s2">
  <div class="spl-s2__image">
    {% if section.settings.section2_image %}
      {{
        section.settings.section2_image
        | image_url: width: 900
        | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 45vw, 100vw', class: 'spl-s2__media'
      }}
    {% else %}
      <div class="spl-s2__placeholder" aria-hidden="true">
        <span>foto: pessoa em movimento</span>
      </div>
    {% endif %}
  </div>

  <div class="spl-s2__content">
    {% if section.settings.headline != blank %}
      <h2>{{ section.settings.headline }}</h2>
    {% endif %}

    {{ section.settings.text }}

    {% render 'shotz-prelaunch-button',
      label: section.settings.button_label,
      link: section.settings.button_link,
      class: 'spl-btn--sm'
    %}
  </div>
</section>

{% schema %}
{
  "name": "Prelaunch — Para quem é",
  "class": "spl-scope spl-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "section2_image",
      "label": "Imagem"
    },
    {
      "type": "html",
      "id": "headline",
      "label": "Título (H2)",
      "info": "Use <br class=\"spl-linebreak\"> para quebra de linha só no desktop.",
      "default": "Para quem acredita que performance<br class=\"spl-linebreak\">acontece todos os dias."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Shotz foi criado para pessoas que vivem em movimento — que conciliam trabalho, treinos e uma rotina intensa, mas ainda escolhem cuidar da própria saúde.</p><p>Porque evoluir não depende de grandes mudanças, e sim de pequenas escolhas feitas todos os dias. Consumir proteína deveria ser uma delas.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "info": "Deixe vazio para ocultar o botão.",
      "default": "Quero fazer parte desse movimento"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão",
      "info": "Deixe vazio para abrir o formulário de cadastro."
    }
  ],
  "presets": [
    {
      "name": "Prelaunch — Para quem é"
    }
  ]
}
{% endschema %}
