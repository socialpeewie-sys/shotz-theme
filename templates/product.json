            "ai_gen_block_a715194_CcYBnm": {
              "type": "ai_gen_block_a715194",
              "settings": {
                "title_1": "Ingredientes",
                "content_1": "<h5>Proteína isolada de soro de leite, água, aroma natural, acidulante ácido cítrico, conservante sorbato de potássio, edulcorantes sucralose e acessulfame de potássio.</h5>",
                "title_2": "Informações nutricionais",
                "content_2": "",
                "title_3": "Descrição do produto",
                "content_3": "<p>A Shotz é diferente de qualquer proteína que você já experimentou. É um shot proteico com<strong> 18g de proteína de alta qualidade</strong> e todos os aminoácidos essenciais em uma <strong>garrafa de 100ml</strong>, criado para rotinas corridas, viagens, longos turnos de trabalho, dias de pouco apetite e tudo mais. Tem sabor de suco, sem textura arenosa e sem causar sensação de estufamento. As pessoas costumam se surpreender com o quão fácil, prática e conveniente é consumir 18g de proteína<br/><br/></p>",
                "desktop_width_percent": 100,
