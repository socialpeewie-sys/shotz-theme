    "blocks_tBwT3X": {
      "type": "_blocks",
      "blocks": {
        "ai_gen_block_4ab66b1_BwTbRC": {
          "type": "ai_gen_block_4ab66b1",
          "settings": {
            "layout": "image_left",
            "desktop_width_percent": 100,
            "gap": 15,
            "padding_vertical": 60,
