{%- liquid
  assign nid = section.id | replace: '_', '' | downcase
  assign s = section.settings
  assign is_cards = false
  if s.layout_style == 'cards'
    assign is_cards = true
  endif
  assign bg_desktop = s.bg_image | default: s.bg_image_mobile
  assign fade_opacity = s.fade_opacity | divided_by: 100.0
  assign card_number_size = s.number_size | times: 0.62 | round
-%}

{% style %}
  .shotz-numeros-{{ nid }} {
    position: relative;
    background-color: {{ s.background_color }};
    padding-top: {{ s.padding_top }}px;
    padding-bottom: {{ s.padding_bottom }}px;
    width: 100%;
  }

  .shotz-numeros-inner-{{ nid }} {
    position: relative;
    z-index: 2;
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .shotz-numeros-heading-{{ nid }} {
    margin: 0;
    font-family: var(--font-heading--family), 'Plus Jakarta Sans', sans-serif;
    font-size: {{ s.heading_size }}px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: {{ s.heading_color }};
  }

  .shotz-numeros-subtitle-{{ nid }} {
    margin: 16px 0 0;
    max-width: 52ch;
    font-family: var(--font-body--family), 'Plus Jakarta Sans', sans-serif;
    font-size: {{ s.subtitle_size }}px;
    line-height: 1.5;
    color: {{ s.subtitle_color }};
  }

  /* ---------- Estilo: lista simples ---------- */

  .shotz-numeros-grid-{{ nid }} {
    margin-top: {{ s.grid_gap_top }}px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px 64px;
  }

  .shotz-numeros-item-{{ nid }} {
    display: flex;
    flex-direction: column;
  }

  .shotz-numeros-number-{{ nid }} {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-heading--family), 'Plus Jakarta Sans', sans-serif;
    font-size: {{ s.number_size }}px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: {{ s.number_color }};
  }

  .shotz-numeros-unit-{{ nid }} {
    margin-left: 2px;
    font-size: 0.42em;
    font-weight: 800;
    letter-spacing: 0;
    color: {{ s.accent_color }};
  }

  .shotz-numeros-label-{{ nid }} {
    margin: 10px 0 0;
    font-family: var(--font-heading--family), 'Plus Jakarta Sans', sans-serif;
    font-size: {{ s.label_size }}px;
    font-weight: 800;
    line-height: 1.2;
    color: {{ s.label_color }};
  }

  /* ---------- Estilo: cards com imagem de fundo ---------- */

  .shotz-numeros-{{ nid }}.is-cards {
    display: flex;
    align-items: center;
    min-height: {{ s.min_height }}px;
    overflow: hidden;
  }

  .shotz-numeros-{{ nid }}.is-cards .shotz-numeros-inner-{{ nid }} {
    width: 100%;
  }

  .shotz-numeros-bg-{{ nid }} {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .shotz-numeros-bg-{{ nid }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ s.bg_position }};
    display: block;
  }

  .shotz-numeros-fade-{{ nid }} {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg, {{ s.background_color }} 0%, {{ s.background_color }} 25%, transparent 70%);
    opacity: {{ fade_opacity }};
  }

  .shotz-numeros-content-{{ nid }} {
    max-width: {{ s.content_max_width }}px;
  }

  .shotz-numeros-eyebrow-{{ nid }} {
    margin: 0 0 18px;
    max-width: 30ch;
    font-family: var(--font-body--family), 'Plus Jakarta Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.6;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: {{ s.eyebrow_color }};
  }

  .shotz-numeros-{{ nid }}.is-cards .shotz-numeros-heading-{{ nid }} + .shotz-numeros-cards-{{ nid }},
  .shotz-numeros-{{ nid }}.is-cards .shotz-numeros-subtitle-{{ nid }} + .shotz-numeros-cards-{{ nid }} {
    margin-top: {{ s.grid_gap_top }}px;
  }

  .shotz-numeros-cards-{{ nid }} {
    display: flex;
    gap: 10px;
    align-items: stretch;
  }

  .shotz-numeros-card-{{ nid }} {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 16px 12px;
    border-radius: 16px;
    text-align: center;
    color: {{ s.card_text_color }};
    background: color-mix(in srgb, {{ s.card_bg }} {{ s.card_opacity }}%, transparent);
    border: 1px solid color-mix(in srgb, {{ s.card_bg }} 70%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
  }

  .shotz-numeros-card-{{ nid }}.is-highlight {
    flex: 1.8 1 0;
    flex-direction: row;
    gap: 14px;
    padding: 18px 20px;
    color: {{ s.highlight_text_color }};
    background: {{ s.highlight_bg }};
    border-color: {{ s.highlight_bg }};
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: 0 10px 28px color-mix(in srgb, {{ s.highlight_bg }} 35%, transparent);
  }

  .shotz-numeros-card-icon-{{ nid }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
  }

  .shotz-numeros-card-icon-{{ nid }} svg {
    width: 22px;
    height: 22px;
  }

  .is-highlight .shotz-numeros-card-icon-{{ nid }} {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.08);
  }

  .shotz-numeros-card-body-{{ nid }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .shotz-numeros-card-number-{{ nid }} {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-heading--family), 'Plus Jakarta Sans', sans-serif;
    font-size: {{ card_number_size }}px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .is-highlight .shotz-numeros-card-number-{{ nid }} {
    font-size: {{ s.number_size }}px;
  }

  .shotz-numeros-card-unit-{{ nid }} {
    margin-left: 2px;
    font-size: 0.6em;
    font-weight: 700;
    letter-spacing: 0;
  }

  .shotz-numeros-card-label-{{ nid }} {
    margin: 0;
    font-family: var(--font-body--family), 'Plus Jakarta Sans', sans-serif;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .is-highlight .shotz-numeros-card-label-{{ nid }} {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .shotz-numeros-card-sublabel-{{ nid }} {
    margin: -2px 0 0;
    font-family: var(--font-body--family), 'Plus Jakarta Sans', sans-serif;
    font-size: 9px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .shotz-numeros-heading-{{ nid }} {
      font-size: {{ s.heading_size | times: 0.62 | round }}px;
    }

    .shotz-numeros-grid-{{ nid }} {
      gap: 32px;
    }

    .shotz-numeros-item-{{ nid }} {
      flex: 0 0 calc(50% - 16px);
    }

    .shotz-numeros-number-{{ nid }} {
      font-size: {{ s.number_size | times: 0.66 | round }}px;
    }

    .shotz-numeros-{{ nid }}.is-cards {
      align-items: flex-start;
      min-height: {{ s.min_height_mobile }}px;
    }

    .shotz-numeros-fade-{{ nid }} {
      background: linear-gradient(180deg, {{ s.background_color }} 0%, {{ s.background_color }} 35%, transparent 80%);
    }

    .shotz-numeros-cards-{{ nid }} {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    .shotz-numeros-card-{{ nid }}.is-highlight {
      grid-column: 1 / -1;
      justify-content: center;
    }

    .shotz-numeros-card-{{ nid }} {
      padding: 12px 6px;
    }

    .shotz-numeros-card-number-{{ nid }} {
      font-size: {{ card_number_size | times: 0.8 | round }}px;
    }

    .is-highlight .shotz-numeros-card-number-{{ nid }} {
      font-size: {{ s.number_size | times: 0.85 | round }}px;
    }
  }
{% endstyle %}

{%- capture icon_attrs -%}
  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"
{%- endcapture -%}

<div class="shotz-numeros-{{ nid }}{% if is_cards %} is-cards{% endif %}">
  {%- if is_cards and bg_desktop != blank -%}
    <div class="shotz-numeros-bg-{{ nid }}">
      <picture>
        {%- if s.bg_image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ s.bg_image_mobile | image_url: width: 600 }} 600w,
              {{ s.bg_image_mobile | image_url: width: 900 }} 900w,
              {{ s.bg_image_mobile | image_url: width: 1200 }} 1200w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          bg_desktop
          | image_url: width: 2400
          | image_tag: loading: 'lazy', alt: '', sizes: '100vw', widths: '750, 1100, 1500, 1920, 2400'
        }}
      </picture>
    </div>
    <div class="shotz-numeros-fade-{{ nid }}"></div>
  {%- endif -%}

  <div class="shotz-numeros-inner-{{ nid }}">
    {%- if is_cards -%}
      <div class="shotz-numeros-content-{{ nid }}">
        {%- if s.eyebrow != blank -%}
          <p class="shotz-numeros-eyebrow-{{ nid }}">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="shotz-numeros-heading-{{ nid }}">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.subtitle != blank -%}
          <p class="shotz-numeros-subtitle-{{ nid }}">{{ s.subtitle }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="shotz-numeros-cards-{{ nid }}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'numero' -%}
                <div class="shotz-numeros-card-{{ nid }}{% if block.settings.highlight %} is-highlight{% endif %}" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != 'none' -%}
                    <span class="shotz-numeros-card-icon-{{ nid }}">
                      <svg {{ icon_attrs }}>
                        {%- case block.settings.icon -%}
                          {%- when 'bolt' -%}
                            <path d="M13 2L5 14H11L9 22L19 9H12L13 2Z" />
                          {%- when 'flame' -%}
                            <path d="M12 3C12 3 6 9 6 14A6 6 0 0 0 18 14C18 10.5 15.5 8 15.5 8C15.5 10.5 14 12 12.8 12C13.8 8.5 12 3 12 3Z" />
                          {%- when 'ban' -%}
                            <circle cx="12" cy="12" r="8" />
                            <line x1="6.4" y1="6.4" x2="17.6" y2="17.6" />
                          {%- when 'bottle' -%}
                            <path d="M9.5 3H14.5V6.5L17 10V20A1 1 0 0 1 16 21H8A1 1 0 0 1 7 20V10L9.5 6.5V3Z" />
                            <line x1="9.5" y1="6.5" x2="14.5" y2="6.5" />
                            <line x1="7" y1="13" x2="17" y2="13" />
                          {%- when 'droplet' -%}
                            <path d="M12 3L17 13A5 5 0 1 1 7 13L12 3Z" />
                          {%- when 'leaf' -%}
                            <ellipse cx="12" cy="12" rx="8" ry="4.4" transform="rotate(-40 12 12)" />
                            <line x1="6.2" y1="17.8" x2="11.6" y2="12.4" />
                          {%- when 'clock' -%}
                            <circle cx="12" cy="12" r="8.5" />
                            <path d="M12 7V12L15 14" />
                        {%- endcase -%}
                      </svg>
                    </span>
                  {%- endif -%}
                  <div class="shotz-numeros-card-body-{{ nid }}">
                    {%- if block.settings.number != blank -%}
                      <span class="shotz-numeros-card-number-{{ nid }}">
                        {{- block.settings.number -}}
                        {%- if block.settings.unit != blank -%}
                          <span class="shotz-numeros-card-unit-{{ nid }}">{{ block.settings.unit }}</span>
                        {%- endif -%}
                      </span>
                    {%- endif -%}
                    {%- if block.settings.label != blank -%}
                      <p class="shotz-numeros-card-label-{{ nid }}">{{ block.settings.label }}</p>
                    {%- endif -%}
                    {%- if block.settings.sublabel != blank -%}
                      <p class="shotz-numeros-card-sublabel-{{ nid }}">{{ block.settings.sublabel }}</p>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      {% if s.heading != blank %}
        <h2 class="shotz-numeros-heading-{{ nid }}">{{ s.heading }}</h2>
      {% endif %}

      {% if s.subtitle != blank %}
        <p class="shotz-numeros-subtitle-{{ nid }}">{{ s.subtitle }}</p>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="shotz-numeros-grid-{{ nid }}">
          {% for block in section.blocks %}
            {% if block.type == 'numero' %}
              <div class="shotz-numeros-item-{{ nid }}" {{ block.shopify_attributes }}>
                {% if block.settings.number != blank %}
                  <span class="shotz-numeros-number-{{ nid }}">
                    {{- block.settings.number -}}
                    {%- if block.settings.unit != blank -%}
                      <span class="shotz-numeros-unit-{{ nid }}">{{ block.settings.unit }}</span>
                    {%- endif -%}
                  </span>
                {% endif %}
                {% if block.settings.label != blank %}
                  <p class="shotz-numeros-label-{{ nid }}">{{ block.settings.label }}</p>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Números em destaque",
  "tag": "section",
  "class": "section-shotz-numeros",
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "Estilo",
      "options": [
        { "value": "cards", "label": "Cards com imagem de fundo" },
        { "value": "classic", "label": "Lista simples" }
      ],
      "default": "cards"
    },
    {
      "type": "header",
      "content": "Conteúdo"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Frase em destaque (acima dos cards)",
      "info": "Só aparece no estilo \"Cards com imagem de fundo\".",
      "default": "A proteína que acompanha sua rotina."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Pequenas escolhas, grandes resultados"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Uma rotina que você mantém vale mais que a perfeita que você abandona. Consistência é a chave."
    },
    {
      "type": "header",
      "content": "Imagem de fundo (estilo cards)"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Imagem de fundo",
      "info": "Deixe o produto do lado direito da foto; os cards ficam à esquerda. Recomendado: 2400 × 800 px."
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Imagem de fundo (celular)",
      "info": "Opcional. Se vazio, usa a imagem acima."
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Foco da imagem",
      "options": [
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Direita" },
        { "value": "left", "label": "Esquerda" },
        { "value": "top", "label": "Topo" },
        { "value": "bottom", "label": "Base" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "fade_opacity",
      "label": "Degradê atrás dos cards",
      "info": "Clareia o lado esquerdo da imagem com a cor de fundo para destacar os cards.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo",
      "default": "#FAF7EF"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Cor da frase em destaque",
      "default": "#0D0D0D"
    },
    {
      "type": "color",
      "id": "highlight_bg",
      "label": "Card em destaque — fundo",
      "default": "#FFB627"
    },
    {
      "type": "color",
      "id": "highlight_text_color",
      "label": "Card em destaque — texto",
      "default": "#0D0D0D"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Cards — fundo",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "card_opacity",
      "label": "Cards — opacidade do fundo",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Cards — texto",
      "default": "#0D0D0D"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Cor do título",
      "default": "#1A2740"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Cor do subtítulo",
      "default": "#5A6273"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Lista simples — cor dos números",
      "default": "#1A2740"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Lista simples — cor da unidade",
      "default": "#0094F6"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Lista simples — cor do rótulo",
      "default": "#1A2740"
    },
    {
      "type": "header",
      "content": "Tipografia"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamanho do título",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Tamanho do subtítulo",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "Tamanho dos números",
      "info": "No estilo cards, é o tamanho do card em destaque; os outros usam cerca de 60%.",
      "min": 40,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 46
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Lista simples — tamanho do rótulo",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Altura mínima (estilo cards)",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 340
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Altura mínima no celular (estilo cards)",
      "info": "Deixe espaço abaixo dos cards para o produto aparecer na foto.",
      "min": 0,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Largura dos cards (estilo cards)",
      "min": 360,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "grid_gap_top",
      "label": "Espaço acima dos números",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largura máxima",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "numero",
      "name": "Número",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Número",
          "default": "21"
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Unidade (destaque)",
          "info": "Sufixo menor, ex.: g, ml, kcal, s."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Rótulo",
          "default": "Rótulo do número"
        },
