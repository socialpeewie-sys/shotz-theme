{% doc %}
  Prova / laudo: "A gente não pede confiança. A gente mostra o laudo."
{% enddoc %}

{{ 'shotz-ciencia.css' | asset_url | stylesheet_tag }}

<section class="sci-proof" id="laudo">
  {% if section.settings.headline != blank %}
    <h2>{{ section.settings.headline }}</h2>
  {% endif %}

  {% if section.settings.lead != blank %}
    <p class="sci-lead">{{ section.settings.lead }}</p>
  {% endif %}
  {% if section.settings.text != blank %}
    <p>{{ section.settings.text }}</p>
  {% endif %}
  {% if section.settings.fine_print != blank %}
    <p class="sci-fine">{{ section.settings.fine_print }}</p>
  {% endif %}

  {% if section.settings.cta_label != blank %}
    <div class="sci-btn-row">
      <a class="sci-btn" href="{{ section.settings.laudo_link | default: '#laudo' }}">
        {{ section.settings.cta_label }}
      </a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "A ciência — Laudo",
  "class": "sci-column",
  "settings": [
    {
      "type": "html",
      "id": "headline",
      "label": "Título (H2)",
      "info": "Use <strong> para destaque e <br> para quebra de linha.",
      "default": "A gente não pede confiança.<br>A gente mostra o <strong>laudo</strong>."
    },
    {
      "type": "inline_richtext",
      "id": "lead",
      "label": "Parágrafo 1",
      "default": "Escrever \"proteína completa\" no rótulo é fácil. Provar é que é difícil."
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Parágrafo 2",
      "default": "Nosso perfil de aminoácidos foi medido em laboratório, não estimado na planilha."
    },
    {
      "type": "inline_richtext",
      "id": "fine_print",
      "label": "Parágrafo 3 (texto suave)",
      "default": "E o que a ciência não promete, a gente também não promete: proteína não substitui treino nem sono. Ela só fecha a conta quando o resto já está de pé."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto do botão",
      "info": "Deixe vazio para ocultar o botão.",
      "default": "VER O LAUDO →"
    },
    {
      "type": "url",
      "id": "laudo_link",
      "label": "Link do laudo",
      "info": "PDF ou página do laudo laboratorial."
    }
  ],
  "presets": [
    {
      "name": "A ciência — Laudo"
    }
  ]
}
{% endschema %}
