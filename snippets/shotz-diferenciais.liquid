{%- doc -%}
  Painel "O que torna o Shotz diferente" — título, subtítulo opcional e 3 números.
  As configurações ficam na seção product-information (grupo "Diferenciais").
  Renderizado no fim dos detalhes do produto (abaixo do acordeão), no desktop
  e no mobile — ver blocks/_product-details.liquid.

  @param {object} settings - Configurações da seção product-information
  @param {string} placement - 'details' (padrão)
{%- enddoc -%}

{%- liquid
  assign has_values = false
  for i in (1..3)
    assign key = 'dif_' | append: i | append: '_value'
    if settings[key] != blank
      assign has_values = true
    endif
  endfor
  assign show = false
  if settings.dif_enabled
    if has_values or request.design_mode
      assign show = true
    endif
  endif
-%}

{%- if show -%}
  <div
    class="shotz-dif shotz-dif--{{ placement }}"
    style="--dif-bg: {{ settings.dif_background }}; --dif-card: {{ settings.dif_card_background }}; --dif-border: {{ settings.dif_card_border }}; --dif-text: {{ settings.dif_text_color }}; --dif-muted: {{ settings.dif_muted_color }}; --dif-accent: {{ settings.dif_accent_color }};"
  >
    {%- if settings.dif_heading != blank -%}
      <h2 class="shotz-dif__heading">{{ settings.dif_heading }}</h2>
    {%- endif -%}
    {%- if settings.dif_subheading != blank -%}
      <div class="shotz-dif__subheading">{{ settings.dif_subheading }}</div>
    {%- endif -%}

    <ul class="shotz-dif__stats" role="list">
      {%- for i in (1..3) -%}
        {%- liquid
          assign vkey = 'dif_' | append: i | append: '_value'
          assign lkey = 'dif_' | append: i | append: '_label'
          assign value = settings[vkey]
          assign label = settings[lkey]
        -%}
        {%- if value != blank or request.design_mode -%}
          <li class="shotz-dif__stat">
            <span class="shotz-dif__value{% if value == blank %} shotz-dif__value--empty{% endif %}">
              {{- value | default: '00%' -}}
            </span>
            {%- if label != blank -%}
              <span class="shotz-dif__label">{{ label }}</span>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  /* Tamanhos reduzidos à metade (legendas com mínimo legível) */
  .shotz-dif {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 10px;
    background: var(--dif-bg);
    color: var(--dif-text);
    border-radius: 12px;
    font-family: var(--font-body--family), 'Plus Jakarta Sans', sans-serif;
  }

  .shotz-dif__heading {
    margin: 0;
    font-family: var(--font-heading--family), 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--dif-text);
  }

  .shotz-dif__subheading {
    margin-top: -3px;
    font-size: 11px;
    line-height: 1.45;
    color: var(--dif-muted);
  }
  .shotz-dif__subheading p { margin: 0; }

  .shotz-dif__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px;
    margin: 2px 0 0;
    padding: 0;
    list-style: none;
  }

  .shotz-dif__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-height: 52px;
    padding: 9px 4px;
    text-align: center;
    background: var(--dif-card);
    border: 1px solid var(--dif-border);
    border-radius: 7px;
  }

  .shotz-dif__value {
    font-family: var(--font-heading--family), 'Plus Jakarta Sans', sans-serif;
    font-size: 16px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--dif-accent);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .shotz-dif__value--empty { opacity: 0.35; }

  .shotz-dif__label {
    font-size: 9px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--dif-muted);
  }

  .shotz-dif--details { width: 100%; margin-top: 4px; }

  @media screen and (min-width: 750px) {
    .shotz-dif {
      gap: 10px;
      padding: 16px;
      border-radius: 16px;
    }
    .shotz-dif__heading { font-size: 16px; }
    .shotz-dif__subheading { font-size: 12px; }
    .shotz-dif__stats { gap: 6px; }
    .shotz-dif__stat { min-height: 60px; gap: 5px; border-radius: 9px; }
    .shotz-dif__value { font-size: 21px; }
    .shotz-dif__label { font-size: 10px; }
  }
{% endstylesheet %}
