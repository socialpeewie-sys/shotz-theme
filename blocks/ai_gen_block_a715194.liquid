{% doc %}
  @prompt
    quero 2 campos com "drop down" editáveis e que eu possa também incluir textos dentro do dropdown
    , na verdade quero que seja um menu de texto, onde ele fica fechado até o usuário clicar nele e abre o texto
    Exemplo: Ingredientes
    Quando o usuário clicar em ingredientes, vai se abrir o dropdown com o texto com os ingredientes, queria ter a pção de colocar imagem também
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tabs-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    font-family: var(--font-paragraph--family, 'Plus Jakarta Sans', sans-serif);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* ---- Cada item do acordeão ---- */
  .ai-tabs__item-{{ ai_gen_id }} {
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: var(--style-border-radius-buttons-primary, {{ block.settings.border_radius }}px);
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  /* ---- Cabeçalho clicável (título + setinha) ---- */
  .ai-tabs__header-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-paragraph--family, 'Plus Jakarta Sans', sans-serif);
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    letter-spacing: 0.01em;
    transition: background 0.18s ease;
  }

  .ai-tabs__header-{{ ai_gen_id }}:hover {
    background: {{ block.settings.header_hover_background }};
  }

  .ai-tabs__header-{{ ai_gen_id }}[aria-expanded="true"] {
    font-weight: {{ block.settings.title_weight | plus: 100 }};
  }

  /* ---- Setinha ---- */
  .ai-tabs__arrow-{{ ai_gen_id }} {
    flex: none;
    width: 18px;
    height: 18px;
    color: {{ block.settings.title_color }};
    transition: transform 0.25s ease;
  }

  .ai-tabs__header-{{ ai_gen_id }}[aria-expanded="true"] .ai-tabs__arrow-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  /* ---- Conteúdo colapsável ---- */
  .ai-tabs__panel-{{ ai_gen_id }} {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.3s ease;
  }

  .ai-tabs__panel-inner-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.padding }}px {{ block.settings.padding }}px;
    font-family: var(--font-paragraph--family, 'Plus Jakarta Sans', sans-serif);
    font-size: {{ block.settings.content_size }}px;
    line-height: 1.6;
    color: {{ block.settings.content_color }};
  }

  .ai-tabs__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: 12px;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-tabs-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-tabs__header-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | minus: 1 }}px;
      padding: 13px 14px;
    }
  }
{% endstyle %}

<accordion-menu-{{ ai_gen_id }}
  class="ai-tabs-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <!-- Item 1 -->
  <div class="ai-tabs__item-{{ ai_gen_id }}">
    <button
      class="ai-tabs__header-{{ ai_gen_id }}"
      type="button"
      aria-expanded="false"
      aria-controls="ai-panel-{{ ai_gen_id }}-0"
      data-tab="0"
    >
      <span>{{ block.settings.title_1 }}</span>
      <svg class="ai-tabs__arrow-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div class="ai-tabs__panel-{{ ai_gen_id }}" id="ai-panel-{{ ai_gen_id }}-0" role="region" data-panel="0">
      <div class="ai-tabs__panel-inner-{{ ai_gen_id }}">
        {% if block.settings.image_1 %}
          <img
            src="{{ block.settings.image_1 | image_url: width: 800 }}"
            alt="{{ block.settings.image_1.alt | escape }}"
            class="ai-tabs__image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image_1.width }}"
            height="{{ block.settings.image_1.height }}"
          >
        {% endif %}
        {{ block.settings.content_1 }}
      </div>
    </div>
  </div>

  <!-- Item 2 -->
  <div class="ai-tabs__item-{{ ai_gen_id }}">
    <button
      class="ai-tabs__header-{{ ai_gen_id }}"
      type="button"
      aria-expanded="false"
      aria-controls="ai-panel-{{ ai_gen_id }}-1"
      data-tab="1"
    >
      <span>{{ block.settings.title_2 }}</span>
      <svg class="ai-tabs__arrow-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div class="ai-tabs__panel-{{ ai_gen_id }}" id="ai-panel-{{ ai_gen_id }}-1" role="region" data-panel="1">
      <div class="ai-tabs__panel-inner-{{ ai_gen_id }}">
        {% if block.settings.image_2 %}
          <img
            src="{{ block.settings.image_2 | image_url: width: 800 }}"
            alt="{{ block.settings.image_2.alt | escape }}"
            class="ai-tabs__image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image_2.width }}"
            height="{{ block.settings.image_2.height }}"
          >
        {% endif %}
        {{ block.settings.content_2 }}
      </div>
    </div>
  </div>

  <!-- Item 3 -->
  <div class="ai-tabs__item-{{ ai_gen_id }}">
    <button
      class="ai-tabs__header-{{ ai_gen_id }}"
      type="button"
      aria-expanded="false"
      aria-controls="ai-panel-{{ ai_gen_id }}-2"
      data-tab="2"
    >
      <span>{{ block.settings.title_3 }}</span>
      <svg class="ai-tabs__arrow-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div class="ai-tabs__panel-{{ ai_gen_id }}" id="ai-panel-{{ ai_gen_id }}-2" role="region" data-panel="2">
      <div class="ai-tabs__panel-inner-{{ ai_gen_id }}">
        {% if block.settings.image_3 %}
          <img
            src="{{ block.settings.image_3 | image_url: width: 800 }}"
            alt="{{ block.settings.image_3.alt | escape }}"
            class="ai-tabs__image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image_3.width }}"
            height="{{ block.settings.image_3.height }}"
          >
        {% endif %}
        {{ block.settings.content_3 }}
      </div>
    </div>
  </div>
</accordion-menu-{{ ai_gen_id }}>

<script>
  (function() {
    class AccordionMenu{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.headers = Array.from(this.querySelectorAll('.ai-tabs__header-{{ ai_gen_id }}'));
        this.allowMultiple = {% if block.settings.allow_multiple %}true{% else %}false{% endif %};

        this.headers.forEach((header) => {
          const panel = header.nextElementSibling;
          header.addEventListener('click', () => this.#toggle(header, panel));
        });

        // Reajusta a altura ao redimensionar a janela (conteúdo aberto)
        window.addEventListener('resize', () => this.#refresh());
      }

      #toggle(header, panel) {
        const isOpen = header.getAttribute('aria-expanded') === 'true';

        if (!this.allowMultiple && !isOpen) {
          // Fecha os demais antes de abrir este
          this.headers.forEach((h) => {
            if (h !== header) this.#close(h, h.nextElementSibling);
          });
        }

        if (isOpen) {
          this.#close(header, panel);
        } else {
          this.#open(header, panel);
        }
      }

      #open(header, panel) {
        header.setAttribute('aria-expanded', 'true');
        panel.style.maxHeight = panel.scrollHeight + 'px';
      }

      #close(header, panel) {
        header.setAttribute('aria-expanded', 'false');
        panel.style.maxHeight = null;
      }

      #refresh() {
        this.headers.forEach((header) => {
          if (header.getAttribute('aria-expanded') === 'true') {
            const panel = header.nextElementSibling;
            panel.style.maxHeight = panel.scrollHeight + 'px';
          }
        });
      }
    }

    if (!customElements.get('accordion-menu-{{ ai_gen_id }}')) {
      customElements.define('accordion-menu-{{ ai_gen_id }}', AccordionMenu{{ ai_gen_id }});
    }
  })();
</script>

