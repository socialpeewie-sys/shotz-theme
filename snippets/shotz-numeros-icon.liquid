{%- doc -%}
  Ícone de traço usado nos cards da seção "Números em destaque".

  @param {string} icon - bolt, flame, ban, bottle, droplet, leaf, clock, muscle ou dumbbell
{%- enddoc -%}

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'bolt' -%}
      <path d="M13 2L5 14H11L9 22L19 9H12L13 2Z" />
    {%- when 'flame' -%}
      <path d="M12 3C12 3 6 9 6 14A6 6 0 0 0 18 14C18 10.5 15.5 8 15.5 8C15.5 10.5 14 12 12.8 12C13.8 8.5 12 3 12 3Z" />
    {%- when 'ban' -%}
      <circle cx="12" cy="12" r="8" />
      <line x1="6.4" y1="6.4" x2="17.6" y2="17.6" />
    {%- when 'bottle' -%}
      <path d="M9.5 3H14.5V6.5L17 10V20A1 1 0 0 1 16 21H8A1 1 0 0 1 7 20V10L9.5 6.5V3Z" />
      <line x1="9.5" y1="6.5" x2="14.5" y2="6.5" />
      <line x1="7" y1="13" x2="17" y2="13" />
    {%- when 'droplet' -%}
      <path d="M12 3L17 13A5 5 0 1 1 7 13L12 3Z" />
    {%- when 'leaf' -%}
      <ellipse cx="12" cy="12" rx="8" ry="4.4" transform="rotate(-40 12 12)" />
      <line x1="6.2" y1="17.8" x2="11.6" y2="12.4" />
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7V12L15 14" />
    {%- when 'muscle' -%}
      <path d="M7 20C5 20 3.5 18.6 3.5 16.5C3.5 12 6 6.5 8.5 4.5C9.6 3.6 11.4 3.8 12 5C12.5 6 12 7.3 10.8 7.8L9.5 8.3L10.5 12C11.6 10.8 13.3 10.2 15 10.5C18.3 11 20.5 13.6 20.5 16.3C20.5 18.4 19 20 17 20H7Z" />
      <path d="M10.5 12C11 13.6 12.4 14.6 14 14.6" />
    {%- when 'dumbbell' -%}
      <line x1="2.5" y1="12" x2="21.5" y2="12" />
      <rect x="5" y="8.5" width="2.5" height="7" rx="0.6" />
      <rect x="16.5" y="8.5" width="2.5" height="7" rx="0.6" />
  {%- endcase -%}
</svg>
