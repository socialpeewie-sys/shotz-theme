      "id": "text_block_2_enabled",
      "label": "Ativar bloco 2",
      "default": true
    },
    {
      "type": "text",
      "id": "text_block_2_title",
      "label": "Título",
      "default": "Título do bloco 2"
    },
    {
      "type": "richtext",
      "id": "text_block_2_text",
      "label": "Texto",
      "default": "<p>Adicione o texto do segundo bloco aqui. Continue descrevendo mais detalhes ou informações importantes.</p>"
    },
    {
      "type": "header",
      "content": "Bloco de texto 3"
    },
    {
      "type": "checkbox",
      "id": "text_block_3_enabled",
      "label": "Ativar bloco 3",
      "default": true
    },
    {
      "type": "text",
      "id": "text_block_3_title",
      "label": "Título",
      "default": "Título do bloco 3"
    },
    {
      "type": "richtext",
      "id": "text_block_3_text",
      "label": "Texto",
      "default": "<p>Adicione o texto do terceiro bloco aqui.</p>"
    },
    {
      "type": "header",
      "content": "Bloco de texto 4"
    },
    {
      "type": "checkbox",
